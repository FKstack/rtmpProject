QFrame[styleRole="videoWidget"] {
    background-color: #202020;
    border: 2px solid #4a4a4a;
}

QFrame[styleRole="videoWidget"] QLabel#deviceNameLabel {
    color: #f0f0f0;
    font-weight: 600;
}

QFrame[styleRole="videoWidget"] QFrame#videoSurface {
    background-color: #000000;
    border: none;
}

QFrame[styleRole="videoWidget"] QLabel#statusLabel {
    color: #bdbdbd;
}

QFrame[styleRole="videoWidget"][dragState="pressed"] {
    background-color: #263847;
    border-color: #4db8ff;
}

QFrame[styleRole="videoWidget"][dragState="dragSource"] {
    background-color: #18242d;
    border-color: #2f88c5;
}

QFrame[styleRole="videoWidget"][dragState="dragTarget"] {
    background-color: #1f3a4b;
    border: 2px dashed #72caff;
}
