{
  "version": 3,
  "configurePresets": [
    {
      "name": "Qt-Debug",
      "displayName": "Windows x64 Qt Debug",
      "inherits": [
        "Qt",
        "Windows-MSVC-vcpkg"
      ],
      "binaryDir": "${sourceDir}/out/build-windows-x64/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "environment": {
        "QTDIR": "<Qt-msvc-root>",
        "VCPKG_ROOT": "<vcpkg-root>"
      }
    },
    {
      "name": "Qt-Release",
      "displayName": "Windows x64 Qt Release",
      "inherits": [
        "Qt",
        "Windows-MSVC-vcpkg"
      ],
      "binaryDir": "${sourceDir}/out/build-windows-x64/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "environment": {
        "QTDIR": "<Qt-msvc-root>",
        "VCPKG_ROOT": "<vcpkg-root>"
      }
    }
  ]
}
